<?xml version="1.0"?>
<ruleset name="AtprotoComments">
	<description>Coding standards for Parolas.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>
	<exclude-pattern>/assets/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress-Extra"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="atproto_comments"/>
				<element value="AtprotoComments"/>
			</property>
			<!-- Base class of the anchor post tests, so its subclasses count as tests. -->
			<property name="custom_test_classes" type="array">
				<element value="Atproto_Comments_Publish_Test_Case"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="parolas"/>
			</property>
		</properties>
	</rule>

	<!-- Tests apply core hooks such as render_block_core/comments. -->
	<rule ref="WordPress.NamingConventions.ValidHookName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Tests follow PHPUnit naming, not WordPress file naming. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
